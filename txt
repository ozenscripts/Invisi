local function toggleRow(page, title, callback)
    local row = make("Frame", {
        Size = UDim2.new(1, -7, 0, 49),
        BackgroundColor3 = panel,
        BorderSizePixel = 0
    }, page)
    make("UICorner", {CornerRadius = UDim.new(0, 8)}, row)

    make("TextLabel", {
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -85, 1, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = white,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, row)

    local enabled = false
    local button = make("TextButton", {
        Position = UDim2.new(1, -65, 0.5, -13),
        Size = UDim2.fromOffset(53, 26),
        BackgroundColor3 = Color3.fromRGB(65, 65, 80),
        Text = "OFF",
        TextColor3 = white,
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        BorderSizePixel = 0
    }, row)
    make("UICorner", {CornerRadius = UDim.new(0, 7)}, button)

    button.MouseButton1Click:Connect(function()
        enabled = not enabled
        button.Text = enabled and "ON" or "OFF"
        TweenService:Create(button, TweenInfo.new(0.15), {
            BackgroundColor3 = enabled and purple or
                Color3.fromRGB(65, 65, 80)
        }):Play()
        if callback then callback(enabled) end
    end)
end

local function actionRow(page, title, actionText, callback)
